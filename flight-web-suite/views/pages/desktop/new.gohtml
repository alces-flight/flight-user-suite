{{ define "content" }}
<div>
    <a
        href="/desktop"
        class="text-sm text-slate-500 text-left"
        data-testid="desktop-launch-back-link"
    >
        < Back to desktops
    </a>
    <div class="flex flex-col gap-y-12 items-stretch mt-6">
        <h1 class="text-center">Launch a desktop session</h1>
        {{ if eq .CoreDependenciesOK false }}
            <div class="message alert max-w-[45rem] mx-auto">
                {{ template "exclamation-triangle.svg" }}
                <div>
                <p class="mb-3">Flight Desktop is not available due to missing core dependencies. Please contact your HPC administrator.</p>
                <p>
                    Missing dependencies:
                    <ul>
                        {{ range .MissingDependencies }}
                            <li>- {{.}}</li>
                        {{end}}
                    </ul>
                </p>
                </div>
            </div>
        {{ else if eq .NumAvailableDesktopTypes 0 }}
            <div class="message alert max-w-[45rem] mx-auto">
                {{ template "exclamation-triangle.svg" }}
                <p>There are no available desktop types. Please contact your HPC administrator.</p>
            </div>
        {{ else if lt .NumAvailableDesktopTypes (len .DesktopTypes) }}
            <div class="message warning max-w-[45rem] mx-auto">
                {{ template "exclamation-triangle.svg" }}
                <p>Not all desktop types are available. Please contact your HPC administrator about enabling additional desktop types.</p>
            </div>
        {{ end }}
        <form
            action="/desktop"
            method="post"
            class="flex flex-col items-center gap-y-12"
            data-testid="desktop-launch-form"
        >
            <section class="flex flex-col items-center w-full">
                <p class="text-center w-full">
                    Select your desktop type from the following options:
                </p>
                <div class="mb-3 flex items-end justify-between gap-4">
                    {{if .Form.Errors.DesktopType}}
                        <p class="text-sm text-red-700" data-testid="desktop-launch-desktop-type-error">{{ .Form.Errors.DesktopType }}</p>
                    {{end}}
                </div>
                <div class="flex flex-wrap justify-center gap-4 w-full" data-testid="desktop-type-cards">
                    {{range .DesktopTypes}}
                        <div data-testid="desktop-type-card--{{ .ID }}">
                            <input
                                type="radio"
                                name="desktop_type"
                                id="{{ .ID }}"
                                value="{{ .ID }}"
                                class="sr-only peer"
                                {{if eq $.Form.DesktopType .ID}}checked{{end}}
                                {{if or (eq $.CoreDependenciesOK false) (eq .IsAvailable false)}}disabled{{end}}
                            >
                            <label
                                for="{{ .ID }}"
                                class="
                                    flex flex-col justify-between
                                    p-5 w-64 h-full
                                    bg-white border border-alces-blue-light rounded-corners
                                    {{ if and $.CoreDependenciesOK .IsAvailable }}
                                        cursor-pointer peer-checked:border-alces-blue peer-checked:shadow transition
                                    {{ else }}
                                        text-slate-400 cursor-not-allowed
                                    {{ end }}
                                "
                                {{if or (eq $.CoreDependenciesOK false) (eq .IsAvailable false)}}
                                    title="Desktop type unavailable"
                                {{ end }}
                            >
                                <div class="flex items-start justify-between gap-4">
                                    <div>
                                        <h3 class="text-xl">{{ .ID }}</h3>
                                        <p class="mt-3 text-sm leading-6
                                            {{ if and $.CoreDependenciesOK .IsAvailable }}
                                                text-slate-700
                                            {{ else }}
                                                text-slate-400
                                            {{ end }}
                                        ">{{ .Summary }}</p>
                                    </div>
                                </div>
                                {{if .URL}}
                                    <p class="mt-4 text-sm">
                                        <a
                                            href="{{ .URL }}"
                                            class="text-alces-blue underline"
                                            title="View the {{ .ID }} project page"
                                            target="_blank"
                                        >More info</a>
                                    </p>
                                {{end}}
                            </label>
                        </div>
                    {{end}}
                </div>
            </section>
            <div class="flex flex-col gap-y-2 items-center text-field">
                <label for="desktop-launch-name">
                    Name your session <span class="text-slate-400">(optional)</span>
                </label>
                <input
                    id="desktop-launch-name"
                    name="name"
                    class="max-w-96"
                    type="text"
                    value="{{ .Form.Name }}"
                    data-testid="desktop-launch-name"
                >
                {{if .Form.Errors.Name}}
                    <p class="mt-2 text-sm text-red-700" data-testid="desktop-launch-name-error">{{ .Form.Errors.Name }}</p>
                {{end}}
            </div>
            <div class="flex flex-col gap-y-2 items-center text-field" data-controller="geometry-inputs">
                <label for="desktop-launch-geometry">
                    Select your desktop resolution
                </label>
                <select
                    id="desktop-launch-geometry"
                    name="geometry"
                    class="custom-select"
                    data-testid="desktop-launch-geometry"
                    data-geometry-inputs-target="geometrySelect"
                >
                    {{range .GeometryOptions}}
                        <option
                            value="{{ .Value }}"
                            {{if eq $.Form.Geometry .Value}}selected{{end}}
                            data-testid="desktop-launch-geometry-option--{{ .Value }}"
                        >{{ .Label }}</option>
                    {{end}}
                </select>
                <div
                    class="flex gap-2 items-center"
                    id="custom-resolution-fields"
                    data-geometry-inputs-target="customFields"
                >
                    <label for="custom_resolution_x">
                        Custom resolution:
                    </label>
                    <input
                        class="max-w-32"
                        data-geometry-inputs-target="input"
                        id="custom_resolution_x"
                        min="0"
                        name="custom_x"
                        placeholder="Width"
                        type="number"
                        value="{{ .Form.CustomX }}"
                    />
                        x
                    <input
                        class="max-w-32"
                        data-geometry-inputs-target="input"
                        min="0"
                        name="custom_y"
                        placeholder="Height"
                        type="number"
                        value="{{ .Form.CustomY }}"
                    />
                </div>
                {{if .Form.Errors.Geometry}}
                    <p class="mt-2 text-sm text-red-700" data-testid="desktop-launch-geometry-error">{{ .Form.Errors.Geometry }}</p>
                {{end}}
            </div>
            <button
                type="submit"
                class="btn !px-12 uppercase {{if or (eq .CoreDependenciesOK false) (eq .NumAvailableDesktopTypes 0)}}btn-disabled{{end}}"
                data-controller="disable-with"
                data-disable-with="Launching..."
                data-disable-with-class="btn-disabled"
                data-testid="desktop-launch-submit"
                {{if or (eq .CoreDependenciesOK false) (eq .NumAvailableDesktopTypes 0)}}
                    disabled
                    {{ if eq .CoreDependenciesOK false }}
                        title="Flight Desktop unavailable"
                    {{ else }}
                        title="No available desktop types"
                    {{ end }}
                {{end}}
            >Launch</button>
        </form>
        {{ if false }}
            <aside class="border border-alces-blue-light bg-sky-50 p-6">
                <h2 class="text-lg font-semibold">Session Details</h2>
                <p class="mt-3 text-sm leading-7 text-slate-700">
                    Desktop sessions run locally for your account. Pick a desktop type that suits your workload, then start
                    a new session with the default geometry or a larger layout.
                </p>
            </aside>
        {{end}}
    </div>
</div>
{{end}}
