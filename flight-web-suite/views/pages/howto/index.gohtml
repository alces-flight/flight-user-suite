{{ define "sidebar" }}
    {{ if .HasGuides }}
        <nav aria-label="Howto guides">
            <ul class="space-y-2">
                {{ range .Guides }}
                    <li>
                        <a
                            href="{{ .URL }}"
                            class="block rounded-full border px-4 py-2 transition-colors {{ if .IsSelected }}border-alces-blue bg-white text-alces-blue-dark{{ else }}border-transparent hover:border-alces-blue-light hover:bg-white{{ end }}"
                            data-testid="howto-guide-link--{{ .Index }}"
                            {{ if .IsSelected }}aria-current="page"{{ end }}
                        >{{ .Title }}</a>
                    </li>
                {{ end }}
            </ul>
        </nav>
    {{ else }}
        <p class="m-0 text-sm text-slate-600" data-testid="howto-sidebar-empty">No guides are currently available.</p>
    {{ end }}
{{ end }}

{{ define "content" }}
<div class="w-[min(60rem,100%)] mx-auto">
    <div class="flex gap-x-4 items-center justify-center w-full mt-6 mb-12 lg:mt-12 px-2 lg:px-8">
        <img src="/assets/images/howto.png" class="size-20" alt="">
        <div>
            <h1 class="mb-1">Flight Howto</h1>
            <p class="m-0">Learn about the Flight User Suite and using your cluster</p>
        </div>
    </div>

    <main class="bg-white p-2 lg:p-8 pt-0 lg:pt-8" data-testid="howto-main-pane">
        {{ if .ShowEmptyState }}
            <p class="m-0 text-xl" data-testid="howto-empty-state">
                There are no user guides currently available. Return later or contact your administrator for more information.
            </p>
        {{ else if .ShowSelectState }}
            <div>
                <h1 class="mb-6" data-testid="howto-welcome">Welcome to Flight Howto!</h1>
                <p class="mb-0">
                    Begin learning how to get the most out of Flight User Suite and your cluster
                    by selecting a user guide
                    <span class="lg:hidden">above</span><span class="max-lg:hidden">from the sidebar</span>.
                </p>
            </div>
        {{ else }}
            <article class="markdown" data-testid="howto-guide-content">
                {{ .GuideContent }}
            </article>
        {{ end }}
    </main>
</div>
{{ end }}
